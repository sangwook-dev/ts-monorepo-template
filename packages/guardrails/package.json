{
  "name": "lint-guardrails",
  "version": "0.1.1",
  "type": "module",
  "description": "규칙을 문서가 아니라 lint로 강제하는 공통 ESLint 설정 — 타입 우회 금지, 레이어 경계(layers), 부작용 없는 도메인(domainLayers). 소비 저장소의 eslint.config.ts가 base를 펼치고 자기 표만 얹는다.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sangwook-dev/ts-monorepo-template.git",
    "directory": "packages/guardrails"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "exports": {
    ".": "./index.mts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint .",
    "check-types": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:lint",
    "@eslint/js": "catalog:lint",
    "eslint-import-resolver-typescript": "catalog:lint",
    "eslint-plugin-boundaries": "catalog:lint",
    "typescript-eslint": "catalog:lint"
  },
  "peerDependencies": {
    "eslint": "catalog:lint"
  },
  "devDependencies": {
    "@app/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:lint",
    "jiti": "catalog:lint",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
